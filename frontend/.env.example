# Base URL the browser uses to reach the API.
# Development: leave as /api and vite.config.ts proxies to VITE_DEV_API_TARGET.
# Production: the full origin, e.g. https://api.uzamobility.rw
VITE_API_BASE_URL=/api

# Only read by vite.config.ts, only in development.
VITE_DEV_API_TARGET=http://localhost:7000

# Shown in the header so nobody demonstrates staging thinking it is production.
VITE_ENVIRONMENT=development
