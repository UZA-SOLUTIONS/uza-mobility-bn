DATABASE_URL="postgresql://postgres:password@localhost:5432/uza-mobility?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (Nodemailer) — set MAIL_ENABLED=true when SMTP is configured
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UZA Mobility <noreply@uza.local>"
APP_NAME=UZA Mobility
FRONTEND_URL=http://localhost:3000

# Platform payment defaults (booking fee, company bank details) are seeded in the
# database and edited in Admin → Platform settings — not via environment variables.

# MongoDB GridFS (images, payment proofs, listing photos)
MONGODB_URI=mongodb://localhost:27017/uza-mobility
# Optional — defaults to database name from the connection string
# MONGODB_DB_NAME=uza-mobility
# GridFS bucket name (collections: <name>.files / <name>.chunks)
GRIDFS_BUCKET_NAME=uploads
# Public base URL for stored file links (API streams from GET /uploads/*)
PUBLIC_UPLOAD_BASE_URL=http://localhost:7000/uploads
