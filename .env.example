DATABASE_URL="postgresql://postgres:password@localhost:5432/uza-mobility?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (Nodemailer) — set MAIL_ENABLED=true when SMTP is configured
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UZA Mobility <noreply@uza.local>"
# Optional fallback only if the bundled logo file is missing from the API build
# MAIL_LOGO_URL=https://yourdomain.com/images/FInal-logo.png
# MAIL_TAGLINE=Electric vehicle marketplace and mobility platform for Rwanda.
# MAIL_SUPPORT_URL=https://yourdomain.com/about
# MAIL_COMPANY_LEGAL_NAME=
# MAIL_COMPANY_LOCATION=
# Optional seed accounts — each account is skipped unless EMAIL and PASSWORD are set
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=
# SEED_ADMIN_ROLES=SUPER_ADMIN,SELLER
# SEED_LOGISTICS_EMAIL=
# SEED_LOGISTICS_PASSWORD=
# SEED_FLEET_EMAIL=
# SEED_FLEET_PASSWORD=
# SEED_FINANCE_EMAIL=
# SEED_FINANCE_PASSWORD=
# SEED_BUYER_EMAIL=
# SEED_BUYER_PASSWORD=
# SEED_SELLER_EMAIL=
# SEED_SELLER_PASSWORD=

APP_NAME=UZA Mobility
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:7000/auth/google/callback

# MongoDB GridFS (images, payment proofs, quote PDFs, listing photos)
MONGODB_URI=mongodb://localhost:27017/uza-mobility
# Optional — defaults to database name from the connection string
# MONGODB_DB_NAME=uza-mobility
# GridFS bucket name (collections: <name>.files / <name>.chunks)
GRIDFS_BUCKET_NAME=uploads
# Public base URL for stored file links (API streams from GET /uploads/*)
PUBLIC_UPLOAD_BASE_URL=http://localhost:7000/uploads

# ExchangeRate-API (USDT/USD → RWF).
EXCHANGE_RATE_API_KEY=
